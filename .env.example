DATABASE_URL="mysql://magnetpay:magnetpay@127.0.0.1:3306/magnetpay"
JWT_SECRET="magnetpay-dev-jwt-secret-change-in-prod"
JWT_REFRESH_SECRET="magnetpay-dev-refresh-secret-change-in-prod"
PORT=4000
NOMBA_MODE=mock

# Hostinger SMTP (OTP emails). Without these, codes are logged + shown as debugCode in non-prod.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="noreply@yourdomain.com"
SMTP_PASS="your-email-password"
EMAIL_FROM="MagnetPay <noreply@yourdomain.com>"

# Public URL for seed asset links
# Production: https://magnetpay.amctraders.online
API_PUBLIC_URL="http://127.0.0.1:4000"
APP_PUBLIC_URL="https://magnetpay.amctraders.online"
APP_DOWNLOAD_URL="https://magnetpay.amctraders.online/download"

# OpenAI — chat translation (English ↔ Mandarin). Leave empty to disable.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Prembly identity verification (NIN / BVN). Use mock when key is absent.
PREMBLY_API_KEY=""
PREMBLY_APP_ID=""
PREMBLY_MODE=mock
