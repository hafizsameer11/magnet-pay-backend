generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  BOTH
}

enum PlatformRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Currency {
  NGN
  CNY
  USD
}

enum KycStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum KycType {
  BVN
  NIN
  CN_ID
  BUSINESS
}

enum TransferStatus {
  CREATED
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum EscrowStatus {
  DRAFT
  AWAITING_SELLER
  AWAITING_FUNDS
  ACTIVE
  COMPLETED
  DISPUTED
  RESOLVED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  FUNDED
  RELEASED
  DISPUTED
}

enum ShipMode {
  AIR
  SEA
  EXPRESS
  CONSOLIDATED
}

enum ShipmentStatus {
  QUOTE
  HOLD_LOCKED
  IN_TRANSIT
  CUSTOMS
  SETTLEMENT_PENDING
  TOP_UP_REQUIRED
  READY_FOR_POD
  DELIVERED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  IN_ESCROW
  SHIPPED
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum DepositStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum LedgerAccountType {
  SYSTEM_CLEARING
  USER_WALLET
  ESCROW_HOLD
  LOGISTICS_HOLD
  FEE_REVENUE
  NOMBA_PAYABLE
}

enum Rail {
  BANK
  WECHAT
  ALIPAY
}

enum RecipientVerificationStatus {
  PENDING
  VERIFIED
  MISMATCH
  FAILED
}

model User {
  id              String       @id @default(uuid())
  phone           String       @unique
  email           String?      @unique
  passcodeHash    String?
  role            UserRole     @default(BUYER)
  platformRole    PlatformRole @default(USER)
  name            String       @default("")
  avatarUrl       String?
  onboardingDone  Boolean      @default(false)
  locale          String       @default("en")
  notificationPrefs Json?      // { emailTransfers, emailEscrow, emailShipments, emailKyc, pushEnabled }
  deviceTokens      Json?      // string[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  sessions        Session[]
  wallets         Wallet[]
  ledgerAccounts  LedgerAccount[]
  recipients      Recipient[]
  deposits        Deposit[]
  withdrawals     Withdrawal[]
  transfersSent   Transfer[]      @relation("TransferSender")
  kycApplications KycApplication[]
  businessProfile BusinessProfile?
  addresses       Address[]
  bankAccounts    BankAccount[]
  sellerStore     SellerStore?
  cart            Cart?
  orders          MarketOrder[]
  rfqs            Rfq[]           @relation("RfqBuyer")
  rfqQuotes       RfqQuote[]      @relation("RfqQuoteSeller")
  wishlist        WishlistItem[]
  favoriteSuppliers FavoriteSupplier[]
  reviews         Review[]
  escrowsAsBuyer  Escrow[]        @relation("EscrowBuyer")
  escrowsAsSeller Escrow[]        @relation("EscrowSeller")
  escrowInvites   EscrowInvite[]  @relation("InviteAccepter")
  disputes        Dispute[]       @relation("DisputeOpener")
  quoteRequests   ShippingQuoteRequest[]
  shipments       Shipment[]
  conversations   ConversationParticipant[]
  messages        Message[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  providerEvents  ProviderEvent[]
  fxConversions   FxConversion[]
  transactions    Transaction[]
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpChallenge {
  id         String    @id @default(uuid())
  phone      String
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@index([email])
}

model KycApplication {
  id        String    @id @default(uuid())
  userId    String
  tier      Int       @default(1)
  type      KycType
  status    KycStatus @default(DRAFT)
  payload   Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model BusinessProfile {
  id           String    @id @default(uuid())
  userId       String    @unique
  companyName  String
  licenseNo    String?
  status       KycStatus @default(DRAFT)
  documents    Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String   @default("Home")
  line1     String
  line2     String?
  city      String
  state     String?
  country   String
  postal    String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BankAccount {
  id          String   @id @default(uuid())
  userId      String
  rail        Rail     @default(BANK)
  currency    Currency
  bankName    String?
  accountName String
  accountNo   String
  country     String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wallet {
  id           String   @id @default(uuid())
  userId       String
  currency     Currency
  balanceMinor BigInt   @default(0)
  holdMinor    BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency])
}

model LedgerAccount {
  id        String            @id @default(uuid())
  userId    String?
  type      LedgerAccountType
  currency  Currency
  name      String
  createdAt DateTime          @default(now())
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  lines     LedgerLine[]

  @@index([userId, type, currency])
}

model LedgerEntry {
  id          String       @id @default(uuid())
  description String
  reference   String?
  createdAt   DateTime     @default(now())
  lines       LedgerLine[]
}

model LedgerLine {
  id        String        @id @default(uuid())
  entryId   String
  accountId String
  debit     BigInt        @default(0)
  credit    BigInt        @default(0)
  entry     LedgerEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account   LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([accountId])
}

model FxRate {
  id        String   @id @default(uuid())
  pair      String   @unique
  rate      Decimal  @db.Decimal(18, 8)
  spreadBps Int      @default(50)
  updatedAt DateTime @updatedAt
}

model FxConversion {
  id            String   @id @default(uuid())
  userId        String
  fromCurrency  Currency
  toCurrency    Currency
  fromMinor     BigInt
  toMinor       BigInt
  rateApplied   Decimal  @db.Decimal(18, 8)
  ledgerEntryId String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Deposit {
  id          String        @id @default(uuid())
  userId      String
  currency    Currency
  amountMinor BigInt
  method      String        @default("virtual_account")
  status      DepositStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Withdrawal {
  id          String           @id @default(uuid())
  userId      String
  currency    Currency
  amountMinor BigInt
  rail        Rail
  destination String
  status      WithdrawalStatus @default(PENDING)
  providerRef String?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Recipient {
  id                   String                       @id @default(uuid())
  userId               String
  name                 String
  subtitle             String                       @default("")
  rail                 Rail                         @default(BANK)
  currency             Currency                     @default(CNY)
  accountHint          String                       @default("")
  country              String                       @default("CN")
  verificationStatus   RecipientVerificationStatus  @default(PENDING)
  verifiedAccountName  String?
  verificationMessage  String?
  verifiedAt           DateTime?
  createdAt            DateTime                     @default(now())
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transfers            Transfer[]

  @@index([userId])
}

model Transfer {
  id          String         @id @default(uuid())
  senderId    String
  recipientId String
  currency    Currency
  amountMinor BigInt
  note        String?
  status      TransferStatus @default(CREATED)
  nombaRef    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  sender      User           @relation("TransferSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   Recipient      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  events      TransferEvent[]

  @@index([senderId])
}

model TransferEvent {
  id         String         @id @default(uuid())
  transferId String
  status     TransferStatus
  message    String
  createdAt  DateTime       @default(now())
  transfer   Transfer       @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
}

model Transaction {
  id             String   @id @default(uuid())
  userId         String
  kind           String
  title          String
  subtitle       String   @default("")
  currency       Currency @default(NGN)
  amountDisplay  String
  amountPositive Boolean?
  status         String?
  icon           String   @default("activity")
  color          String   @default("#0E3B2E")
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, currency])
}

model Category {
  id       String    @id @default(uuid())
  slug     String    @unique
  name     String
  products Product[]
}

model SellerStore {
  id          String    @id @default(uuid())
  userId      String    @unique
  name        String
  description String?   @db.Text
  verified    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]
  favorites   FavoriteSupplier[]
}

model Product {
  id          String         @id @default(uuid())
  storeId     String
  categoryId  String?
  title       String
  description String?        @db.Text
  priceMinor  BigInt
  currency    Currency       @default(USD)
  imageUrl    String?
  moq         String         @default("1 unit")
  rating      Float          @default(4.5)
  stock       Int?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  store       SellerStore    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  media       ProductMedia[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  wishlist    WishlistItem[]
  reviews     Review[]

  @@index([storeId])
  @@index([categoryId])
}

model ProductMedia {
  id        String  @id @default(uuid())
  productId String
  url       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  productId String
  qty       Int     @default(1)
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model MarketOrder {
  id          String      @id @default(uuid())
  userId      String
  status      OrderStatus @default(DRAFT)
  totalMinor  BigInt
  currency    Currency    @default(USD)
  supplier    String      @default("")
  escrowId    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       OrderItem[]

  @@index([userId])
}

model OrderItem {
  id          String      @id @default(uuid())
  orderId     String
  productId   String
  title       String
  qty         Int
  priceMinor  BigInt
  order       MarketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Rfq {
  id          String     @id @default(uuid())
  buyerId     String
  title       String
  description String?    @db.Text
  qty         String?
  status      String     @default("open")
  createdAt   DateTime   @default(now())
  buyer       User       @relation("RfqBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  quotes      RfqQuote[]

  @@index([buyerId])
}

model RfqQuote {
  id          String   @id @default(uuid())
  rfqId       String
  sellerId    String
  amountMinor BigInt
  currency    Currency @default(USD)
  note        String?
  createdAt   DateTime @default(now())
  rfq         Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  seller      User     @relation("RfqQuoteSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([rfqId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model FavoriteSupplier {
  id            String      @id @default(uuid())
  userId        String
  sellerStoreId String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  store         SellerStore @relation(fields: [sellerStoreId], references: [id], onDelete: Cascade)

  @@unique([userId, sellerStoreId])
  @@index([userId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Escrow {
  id             String           @id @default(uuid())
  title          String
  buyerId        String
  sellerId       String?
  amountMinor    BigInt
  currency       Currency         @default(CNY)
  status         EscrowStatus     @default(DRAFT)
  platformFeeBps Int              @default(150)
  inviteToken    String?          @unique
  inspectorId    String?
  progress       Float            @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  buyer          User             @relation("EscrowBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller         User?            @relation("EscrowSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  milestones     EscrowMilestone[]
  invites        EscrowInvite[]
  documents      EscrowDocument[]
  disputes       Dispute[]

  @@index([buyerId])
  @@index([sellerId])
}

model EscrowInvite {
  id               String    @id @default(uuid())
  escrowId         String
  phone            String?
  email            String?
  token            String    @unique
  expiresAt        DateTime
  acceptedByUserId String?
  createdAt        DateTime  @default(now())
  escrow           Escrow    @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  acceptedBy       User?     @relation("InviteAccepter", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([escrowId])
}

model EscrowMilestone {
  id                  String          @id @default(uuid())
  escrowId            String
  label               String
  amountMinor         BigInt
  sortOrder           Int             @default(0)
  status              MilestoneStatus @default(PENDING)
  releaseRequestedAt  DateTime?
  escrow              Escrow          @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  @@index([escrowId])
}

model EscrowDocument {
  id        String   @id @default(uuid())
  escrowId  String
  name      String
  url       String
  createdAt DateTime @default(now())
  escrow    Escrow   @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  @@index([escrowId])
}

model Dispute {
  id          String   @id @default(uuid())
  escrowId    String
  openedById  String
  reason      String
  evidence    Json?
  outcome     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  escrow      Escrow   @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  openedBy    User     @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Cascade)

  @@index([escrowId])
}

model ShippingQuoteRequest {
  id          String     @id @default(uuid())
  userId      String
  cargoDesc   String
  cbm         Float
  weightKg    Float
  origin      String
  destination String
  mode        ShipMode   @default(SEA)
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotes      ShippingQuote[]

  @@index([userId])
}

model ShippingQuote {
  id             String               @id @default(uuid())
  requestId      String
  estimatedMinor BigInt
  currency       Currency             @default(NGN)
  validUntil     DateTime
  createdAt      DateTime             @default(now())
  request        ShippingQuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  shipment       Shipment?

  @@index([requestId])
}

model Shipment {
  id          String              @id @default(uuid())
  userId      String
  quoteId     String              @unique
  ref         String              @unique
  route       String
  mode        ShipMode
  status      ShipmentStatus      @default(HOLD_LOCKED)
  eta         String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote       ShippingQuote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  hold        ShipmentHold?
  settlement  ShipmentSettlement?
  events      ShipmentEvent[]
  documents   ShipmentDocument[]

  @@index([userId])
}

model ShipmentHold {
  id          String   @id @default(uuid())
  shipmentId  String   @unique
  lockedMinor BigInt
  currency    Currency @default(NGN)
  createdAt   DateTime @default(now())
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model ShipmentSettlement {
  id          String   @id @default(uuid())
  shipmentId  String   @unique
  finalMinor  BigInt
  currency    Currency @default(NGN)
  cashbackMinor BigInt @default(0)
  topUpMinor  BigInt   @default(0)
  settledAt   DateTime @default(now())
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model ShipmentEvent {
  id         String         @id @default(uuid())
  shipmentId String
  status     ShipmentStatus
  message    String
  createdAt  DateTime       @default(now())
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model ShipmentDocument {
  id         String   @id @default(uuid())
  shipmentId String
  kind       String
  name       String
  url        String
  createdAt  DateTime @default(now())
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model Conversation {
  id           String                     @id @default(uuid())
  subject      String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  body           String       @db.Text
  attachmentUrl  String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String   @default("")
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model FeeConfig {
  id    String @id @default(uuid())
  key   String @unique
  value Int
}

model FeatureFlag {
  id      String  @id @default(uuid())
  key     String  @unique
  enabled Boolean @default(false)
}

model ProviderEvent {
  id        String   @id @default(uuid())
  userId    String?
  provider  String   @default("nomba")
  kind      String
  payload   Json
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([provider, createdAt])
}
