generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  BOTH
}

enum PlatformRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Currency {
  NGN
  CNY
  USD
}

enum KycStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum KycType {
  BVN
  NIN
  CN_ID
  BUSINESS
}

enum TransferStatus {
  CREATED
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum EscrowStatus {
  DRAFT
  AWAITING_SELLER
  AWAITING_FUNDS
  ACTIVE
  COMPLETED
  DISPUTED
  RESOLVED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  FUNDED
  RELEASED
  DISPUTED
}

enum ShipMode {
  AIR
  SEA
  EXPRESS
  CONSOLIDATED
}

enum ShipmentStatus {
  QUOTE
  HOLD_LOCKED
  IN_TRANSIT
  CUSTOMS
  SETTLEMENT_PENDING
  TOP_UP_REQUIRED
  READY_FOR_POD
  DELIVERED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  IN_ESCROW
  SHIPPED
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum DeliveryMethod {
  PICKUP
  DOORSTEP
}

enum LogisticsStatus {
  NOT_BOOKED
  QUOTE_PENDING
  BOOKED
  IN_TRANSIT
  DELIVERED
}

enum ClaimStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum DepositStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum LedgerAccountType {
  SYSTEM_CLEARING
  USER_WALLET
  ESCROW_HOLD
  LOGISTICS_HOLD
  FEE_REVENUE
  NOMBA_PAYABLE
}

enum Rail {
  BANK
  WECHAT
  ALIPAY
}

enum RecipientVerificationStatus {
  PENDING
  VERIFIED
  MISMATCH
  FAILED
}

model User {
  id              String       @id @default(uuid())
  phone           String       @unique
  email           String?      @unique
  passcodeHash    String?
  role            UserRole     @default(BUYER)
  platformRole    PlatformRole @default(USER)
  name            String       @default("")
  avatarUrl       String?
  onboardingDone  Boolean      @default(false)
  locale          String       @default("en")
  notificationPrefs Json?      // { emailTransfers, emailEscrow, emailShipments, emailKyc, pushEnabled }
  deviceTokens      Json?      // string[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  sessions        Session[]
  wallets         Wallet[]
  ledgerAccounts  LedgerAccount[]
  recipients      Recipient[]
  deposits        Deposit[]
  withdrawals     Withdrawal[]
  transfersSent   Transfer[]      @relation("TransferSender")
  kycApplications KycApplication[]
  businessProfile BusinessProfile?
  addresses       Address[]
  bankAccounts    BankAccount[]
  sellerStore     SellerStore?
  sellerMemberships SellerStoreMember[]
  fapiaoIssued    Fapiao[]        @relation("FapiaoSeller")
  fapiaoReceived  Fapiao[]        @relation("FapiaoBuyer")
  blocksGiven     UserBlock[]     @relation("Blocker")
  blocksReceived  UserBlock[]     @relation("Blocked")
  cart            Cart?
  orders          MarketOrder[]
  rfqs            Rfq[]           @relation("RfqBuyer")
  rfqQuotes       RfqQuote[]      @relation("RfqQuoteSeller")
  wishlist        WishlistItem[]
  favoriteSuppliers FavoriteSupplier[]
  reviews         Review[]
  escrowsAsBuyer  Escrow[]        @relation("EscrowBuyer")
  escrowsAsSeller Escrow[]        @relation("EscrowSeller")
  escrowInvites   EscrowInvite[]  @relation("InviteAccepter")
  disputes        Dispute[]       @relation("DisputeOpener")
  disputesAssigned Dispute[]      @relation("DisputeAssignee")
  orderNotes      OrderNote[]     @relation("OrderNoteAuthor")
  productViews    ProductView[]
  quoteRequests   ShippingQuoteRequest[]
  shipments       Shipment[]
  shipmentClaims  ShipmentClaim[]
  conversations   ConversationParticipant[]
  messages        Message[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  providerEvents  ProviderEvent[]
  fxConversions   FxConversion[]
  transactions    Transaction[]
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpChallenge {
  id         String    @id @default(uuid())
  phone      String
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@index([email])
}

model KycApplication {
  id        String    @id @default(uuid())
  userId    String
  tier      Int       @default(1)
  type      KycType
  status    KycStatus @default(DRAFT)
  payload   Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model BusinessProfile {
  id           String    @id @default(uuid())
  userId       String    @unique
  companyName  String
  licenseNo    String?
  status       KycStatus @default(DRAFT)
  documents    Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String   @default("Home")
  line1     String
  line2     String?
  city      String
  state     String?
  country   String
  postal    String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BankAccount {
  id          String   @id @default(uuid())
  userId      String
  rail        Rail     @default(BANK)
  currency    Currency
  bankName    String?
  accountName String
  accountNo   String
  country     String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wallet {
  id           String   @id @default(uuid())
  userId       String
  currency     Currency
  balanceMinor BigInt   @default(0)
  holdMinor    BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency])
}

model LedgerAccount {
  id        String            @id @default(uuid())
  userId    String?
  type      LedgerAccountType
  currency  Currency
  name      String
  createdAt DateTime          @default(now())
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  lines     LedgerLine[]

  @@index([userId, type, currency])
}

model LedgerEntry {
  id          String       @id @default(uuid())
  description String
  reference   String?
  createdAt   DateTime     @default(now())
  lines       LedgerLine[]
}

model LedgerLine {
  id        String        @id @default(uuid())
  entryId   String
  accountId String
  debit     BigInt        @default(0)
  credit    BigInt        @default(0)
  entry     LedgerEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account   LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([accountId])
}

model FxRate {
  id        String   @id @default(uuid())
  pair      String   @unique
  rate      Decimal  @db.Decimal(18, 8)
  spreadBps Int      @default(50)
  updatedAt DateTime @updatedAt
}

model FxConversion {
  id            String   @id @default(uuid())
  userId        String
  fromCurrency  Currency
  toCurrency    Currency
  fromMinor     BigInt
  toMinor       BigInt
  rateApplied   Decimal  @db.Decimal(18, 8)
  ledgerEntryId String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Deposit {
  id          String        @id @default(uuid())
  userId      String
  currency    Currency
  amountMinor BigInt
  method      String        @default("virtual_account")
  status      DepositStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Withdrawal {
  id          String           @id @default(uuid())
  userId      String
  currency    Currency
  amountMinor BigInt
  rail        Rail
  destination String
  status      WithdrawalStatus @default(PENDING)
  providerRef String?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Recipient {
  id                   String                       @id @default(uuid())
  userId               String
  name                 String
  subtitle             String                       @default("")
  rail                 Rail                         @default(BANK)
  currency             Currency                     @default(CNY)
  accountHint          String                       @default("")
  country              String                       @default("CN")
  verificationStatus   RecipientVerificationStatus  @default(PENDING)
  verifiedAccountName  String?
  verificationMessage  String?
  verifiedAt           DateTime?
  createdAt            DateTime                     @default(now())
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transfers            Transfer[]

  @@index([userId])
}

model Transfer {
  id          String         @id @default(uuid())
  senderId    String
  recipientId String
  currency    Currency
  amountMinor BigInt
  note        String?
  status      TransferStatus @default(CREATED)
  nombaRef    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  sender      User           @relation("TransferSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   Recipient      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  events      TransferEvent[]

  @@index([senderId])
}

model TransferEvent {
  id         String         @id @default(uuid())
  transferId String
  status     TransferStatus
  message    String
  createdAt  DateTime       @default(now())
  transfer   Transfer       @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
}

model Transaction {
  id             String   @id @default(uuid())
  userId         String
  kind           String
  title          String
  subtitle       String   @default("")
  currency       Currency @default(NGN)
  amountDisplay  String
  amountPositive Boolean?
  status         String?
  icon           String   @default("activity")
  color          String   @default("#0E3B2E")
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, currency])
}

model Category {
  id                   String     @id @default(uuid())
  slug                 String     @unique
  name                 String
  defaultParcelTypeId  String?
  products             Product[]
  defaultParcelType    ParcelType? @relation("CategoryDefaultParcelType", fields: [defaultParcelTypeId], references: [id], onDelete: SetNull)

  @@index([defaultParcelTypeId])
}

model SellerStore {
  id          String    @id @default(uuid())
  userId      String    @unique
  name        String
  description String?   @db.Text
  bannerUrl   String?
  logoUrl     String?
  verified    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]
  favorites   FavoriteSupplier[]
  members     SellerStoreMember[]
  teamInvites SellerTeamInvite[]
}

enum ProductModerationStatus {
  ACTIVE
  PENDING
  REPORTED
  HIDDEN
  REJECTED
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  status    String    @default("verified")
  country   String    @default("CN")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([name])
}

model Product {
  id                 String                  @id @default(uuid())
  storeId            String
  categoryId         String?
  brandId            String?
  title              String
  description        String?                 @db.Text
  priceMinor         BigInt
  currency           Currency                @default(USD)
  imageUrl           String?
  moq                String                  @default("1 unit")
  rating             Float                   @default(4.5)
  stock              Int?
  variantAxes        Json?
  pricingTiers       Json?
  cbmPerUnit         Float?
  weightKgPerUnit    Float?
  originHub          String?
  leadTimeMin        Int?
  leadTimeMax        Int?
  packagingType      String?
  defaultIncoterm    String?                 @default("FOB")
  parcelTypeId       String?
  active             Boolean                 @default(true)
  moderationStatus   ProductModerationStatus @default(ACTIVE)
  flagReason         String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  store              SellerStore             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category           Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand              Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  parcelType         ParcelType?             @relation("ProductParcelType", fields: [parcelTypeId], references: [id], onDelete: SetNull)
  media              ProductMedia[]
  variants           ProductVariant[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  wishlist           WishlistItem[]
  reviews            Review[]
  views              ProductView[]

  @@index([storeId])
  @@index([categoryId])
  @@index([brandId])
  @@index([parcelTypeId])
}

model ProductView {
  id        String   @id @default(uuid())
  productId String
  userId    String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([userId])
}

model ProductVariant {
  id         String      @id @default(uuid())
  productId  String
  sku        String?
  options    Json
  priceMinor BigInt
  stock      Int?
  imageUrl   String?
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model ProductMedia {
  id        String  @id @default(uuid())
  productId String
  url       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id         String          @id @default(uuid())
  cartId     String
  productId  String
  variantId  String?
  variantKey String          @default("")
  qty        Int             @default(1)
  cart       Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantKey])
}

model MarketOrder {
  id          String      @id @default(uuid())
  userId      String
  status      OrderStatus @default(DRAFT)
  totalMinor  BigInt
  currency    Currency    @default(USD)
  supplier    String      @default("")
  escrowId    String?
  tracking    String?
  carrier     String?
  sellerNote  String?     @db.Text
  shipmentId  String?     @unique
  deliveryMethod   DeliveryMethod?
  deliveryAddress  Json?
  logisticsStatus  LogisticsStatus @default(NOT_BOOKED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipment    Shipment?   @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  quoteRequests ShippingQuoteRequest[]
  notes       OrderNote[]

  @@index([userId])
  @@index([shipmentId])
}

model OrderNote {
  id        String      @id @default(uuid())
  orderId   String
  authorId  String
  body      String      @db.Text
  createdAt DateTime    @default(now())
  order     MarketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author    User        @relation("OrderNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([authorId])
}

model OrderItem {
  id           String          @id @default(uuid())
  orderId      String
  productId    String
  variantId    String?
  variantLabel String?
  title        String
  qty          Int
  priceMinor   BigInt
  order        MarketOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Rfq {
  id          String     @id @default(uuid())
  buyerId     String
  title       String
  description String?    @db.Text
  qty         String?
  status      String     @default("open")
  createdAt   DateTime   @default(now())
  buyer       User       @relation("RfqBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  quotes      RfqQuote[]

  @@index([buyerId])
}

model RfqQuote {
  id          String   @id @default(uuid())
  rfqId       String
  sellerId    String
  amountMinor BigInt
  currency    Currency @default(USD)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rfq         Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  seller      User     @relation("RfqQuoteSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([rfqId])
  @@index([sellerId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model FavoriteSupplier {
  id            String      @id @default(uuid())
  userId        String
  sellerStoreId String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  store         SellerStore @relation(fields: [sellerStoreId], references: [id], onDelete: Cascade)

  @@unique([userId, sellerStoreId])
  @@index([userId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Escrow {
  id             String           @id @default(uuid())
  title          String
  buyerId        String
  sellerId       String?
  amountMinor    BigInt
  currency       Currency         @default(CNY)
  status         EscrowStatus     @default(DRAFT)
  platformFeeBps Int              @default(150)
  inviteToken    String?          @unique
  inspectorId    String?
  progress       Float            @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  buyer          User             @relation("EscrowBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller         User?            @relation("EscrowSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  milestones     EscrowMilestone[]
  invites        EscrowInvite[]
  documents      EscrowDocument[]
  disputes       Dispute[]

  @@index([buyerId])
  @@index([sellerId])
}

model EscrowInvite {
  id               String    @id @default(uuid())
  escrowId         String
  phone            String?
  email            String?
  token            String    @unique
  expiresAt        DateTime
  acceptedByUserId String?
  createdAt        DateTime  @default(now())
  escrow           Escrow    @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  acceptedBy       User?     @relation("InviteAccepter", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([escrowId])
}

model EscrowMilestone {
  id                  String          @id @default(uuid())
  escrowId            String
  label               String
  amountMinor         BigInt
  sortOrder           Int             @default(0)
  status              MilestoneStatus @default(PENDING)
  releaseRequestedAt  DateTime?
  escrow              Escrow          @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  @@index([escrowId])
}

model EscrowDocument {
  id        String   @id @default(uuid())
  escrowId  String
  name      String
  url       String
  createdAt DateTime @default(now())
  escrow    Escrow   @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  @@index([escrowId])
}

model Dispute {
  id          String   @id @default(uuid())
  escrowId    String
  openedById  String
  assigneeId  String?
  reason      String
  status      String   @default("OPEN")
  priority    String   @default("normal")
  evidence    Json?
  outcome     String?
  ruling      String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  escrow      Escrow   @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  openedBy    User     @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Cascade)
  assignee    User?    @relation("DisputeAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([escrowId])
  @@index([status])
}

model ShippingQuoteRequest {
  id                  String          @id @default(uuid())
  userId              String
  orderId             String?
  parcelTypeId        String?
  cargoDesc           String
  cbm                 Float
  weightKg            Float
  origin              String
  destination         String
  mode                ShipMode        @default(SEA)
  destinationDelivery DeliveryMethod?
  createdAt           DateTime        @default(now())
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  order               MarketOrder?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  parcelType          ParcelType?     @relation(fields: [parcelTypeId], references: [id], onDelete: SetNull)
  quotes              ShippingQuote[]

  @@index([userId])
  @@index([orderId])
  @@index([parcelTypeId])
}

model ShippingQuote {
  id             String               @id @default(uuid())
  requestId      String
  partnerId      String?
  estimatedMinor BigInt
  currency       Currency             @default(NGN)
  validUntil     DateTime
  etaLabel       String?
  serviceLabel   String?
  badgeLabel     String?
  includes       Json?
  ecoFriendly    Boolean              @default(false)
  createdAt      DateTime             @default(now())
  request        ShippingQuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  partner        LogisticsPartner?    @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  shipment       Shipment?

  @@index([requestId])
  @@index([partnerId])
}

model Shipment {
  id          String              @id @default(uuid())
  userId      String
  quoteId     String              @unique
  ref         String              @unique
  route       String
  mode        ShipMode
  status      ShipmentStatus      @default(HOLD_LOCKED)
  eta         String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote       ShippingQuote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  hold        ShipmentHold?
  settlement  ShipmentSettlement?
  events      ShipmentEvent[]
  documents   ShipmentDocument[]
  claims      ShipmentClaim[]
  marketOrder MarketOrder?

  @@index([userId])
}

model ShipmentHold {
  id          String   @id @default(uuid())
  shipmentId  String   @unique
  lockedMinor BigInt
  currency    Currency @default(NGN)
  createdAt   DateTime @default(now())
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model ShipmentSettlement {
  id            String   @id @default(uuid())
  shipmentId    String   @unique
  finalMinor    BigInt
  currency      Currency @default(NGN)
  cashbackMinor BigInt   @default(0)
  topUpMinor    BigInt   @default(0)
  breakdown     Json?
  notes         String?  @db.Text
  settledAt     DateTime @default(now())
  shipment      Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model ShipmentEvent {
  id         String         @id @default(uuid())
  shipmentId String
  status     ShipmentStatus
  message    String
  createdAt  DateTime       @default(now())
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model ShipmentDocument {
  id         String   @id @default(uuid())
  shipmentId String
  kind       String
  name       String
  url        String
  createdAt  DateTime @default(now())
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model ShipmentClaim {
  id           String      @id @default(uuid())
  shipmentId   String
  userId       String
  type         String
  amountMinor  BigInt?
  currency     Currency    @default(NGN)
  description  String      @db.Text
  evidenceUrls Json        @default("[]")
  status       ClaimStatus @default(OPEN)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  shipment     Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([userId])
}

model Conversation {
  id            String                     @id @default(uuid())
  subject       String?
  productId     String?
  latestQuoteId String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  participants  ConversationParticipant[]
  messages      Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  pinnedAt       DateTime?
  muted          Boolean      @default(false)
  archivedAt     DateTime?
  hiddenAt       DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  body           String       @db.Text
  attachmentUrl  String?
  quoteId        String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  quote          RfqQuote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([quoteId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String   @default("")
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum LogisticsPartnerKind {
  FREIGHT_FORWARDER
  WAREHOUSE
  CUSTOMS_BROKER
  LAST_MILE
}

model LogisticsPartner {
  id           String               @id @default(uuid())
  name         String
  code         String               @unique
  kind         LogisticsPartnerKind @default(FREIGHT_FORWARDER)
  modes        Json                 @default("[\"SEA\"]")
  active       Boolean              @default(true)
  rating       Float?
  serviceLabel String?
  contactName  String?
  contactPhone String?
  contactEmail String?
  notes        String?              @db.Text
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  rates        LogisticsPartnerRate[]
  quotes       ShippingQuote[]

  @@index([active])
}

model LogisticsPartnerRate {
  id                 String           @id @default(uuid())
  partnerId          String
  parcelTypeId       String?
  mode               ShipMode         @default(SEA)
  baseSurchargeMinor Int              @default(0)
  rateMultiplierBps  Int              @default(10000)
  etaLabel           String           @default("26–32 days")
  badgeLabel         String?
  includes           Json             @default("[\"Insurance\", \"Customs paperwork\"]")
  ecoFriendly        Boolean          @default(false)
  active             Boolean          @default(true)
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  partner            LogisticsPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  parcelType         ParcelType?      @relation(fields: [parcelTypeId], references: [id], onDelete: SetNull)

  @@index([partnerId, mode, active])
  @@index([parcelTypeId])
}

model FreightPricing {
  id                    String   @id @default("default")
  airBaseMinor          Int      @default(450000)
  seaBaseMinor          Int      @default(180000)
  expressBaseMinor      Int      @default(600000)
  consolidatedBaseMinor Int      @default(220000)
  cbmMultiplier         Int      @default(100000)
  weightMultiplier      Int      @default(2500)
  updatedAt             DateTime @updatedAt
}

model ParcelType {
  id             String                 @id @default(uuid())
  code           String                 @unique
  name           String
  baseMinor      Int
  ratePerKgMinor Int
  active         Boolean                @default(true)
  sortOrder      Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  quoteRequests  ShippingQuoteRequest[]
  products       Product[]              @relation("ProductParcelType")
  categories     Category[]             @relation("CategoryDefaultParcelType")
  partnerRates   LogisticsPartnerRate[]

  @@index([active, sortOrder])
}

model LogisticsEstimateConfig {
  id                  String   @id @default("default")
  usdNgnEstimateRate  Int      @default(165000)
  estimateDisclaimer  String   @default("This is an estimate, not the final price. Final cost is set when goods clear customs. Any difference is credited to your ₦ wallet or requires top-up before collection.")
  updatedAt           DateTime @updatedAt
}

model ComplianceLimits {
  id                        String   @id @default("default")
  unverifiedNgnDailyCapMinor Int     @default(0)
  ngnTier1DailyCapMinor     Int      @default(50000000)
  ngnTier2DailyCapMinor     Int      @default(2000000000)
  cnyDailyCapMinor          Int      @default(20000000)
  minTierDeposit            Int      @default(1)
  minTierWithdraw           Int      @default(1)
  minTierCrossBorder        Int      @default(2)
  minTierMarketCheckout     Int      @default(2)
  minTierLogistics          Int      @default(2)
  allowBasicWhilePending    Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model FeeConfig {
  id    String @id @default(uuid())
  key   String @unique
  value Int
}

model FeatureFlag {
  id      String  @id @default(uuid())
  key     String  @unique
  enabled Boolean @default(false)
}

model ProviderEvent {
  id        String   @id @default(uuid())
  userId    String?
  provider  String   @default("nomba")
  kind      String
  payload   Json
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([provider, createdAt])
}

model SellerStoreMember {
  id       String      @id @default(uuid())
  storeId  String
  userId   String
  role     String
  joinedAt DateTime    @default(now())
  store    SellerStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
}

model SellerTeamInvite {
  id          String      @id @default(uuid())
  storeId     String
  token       String      @unique
  phone       String?
  email       String?
  role        String
  status      String      @default("pending")
  invitedById String
  createdAt   DateTime    @default(now())
  expiresAt   DateTime
  store       SellerStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([email])
  @@index([storeId, status])
}

model Fapiao {
  id           String   @id @default(uuid())
  sellerUserId String
  buyerUserId  String?
  orderId      String?
  amountMinor  BigInt
  currency     Currency @default(CNY)
  vatRate      String   @default("13")
  uscc         String?
  documentUrl  String?
  status       String   @default("issued")
  issuedAt     DateTime @default(now())
  seller       User     @relation("FapiaoSeller", fields: [sellerUserId], references: [id], onDelete: Cascade)
  buyer        User?    @relation("FapiaoBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)

  @@index([sellerUserId])
  @@index([orderId])
}

model UserBlock {
  id            String   @id @default(uuid())
  userId        String
  blockedUserId String
  createdAt     DateTime @default(now())
  user          User     @relation("Blocker", fields: [userId], references: [id], onDelete: Cascade)
  blocked       User     @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedUserId])
  @@index([userId])
}

model AdminRecord {
  id         String   @id @default(uuid())
  domain     String
  externalId String?
  title      String
  subtitle   String?
  status     String?
  payload    Json     @default("{}")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([domain])
  @@index([domain, status])
}
